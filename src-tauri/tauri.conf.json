{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pirosman Studio",
  "version": "0.1.0-alpha",
  "identifier": "studio.pirosman.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pirosman Studio",
        "width": 1600,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 700,
        "backgroundColor": "#03060c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost pcache: http://pcache.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pirosman Studio contributors",
    "shortDescription": "Open-source video editor with built-in version control",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": false }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
