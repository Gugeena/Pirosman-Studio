{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run fetch-ffmpeg && npm run build:ofx && npm run dev",
    "beforeBuildCommand": "npm run fetch-ffmpeg && npm run build:ofx && npm run build"
  },
  "bundle": {
    "resources": {
      "ffmpeg/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "ffmpeg/ffprobe.exe": "ffmpeg/ffprobe.exe",
      "ffmpeg/manifest.json": "ffmpeg/manifest.json",
      "ffmpeg/LICENSE.txt": "ffmpeg/LICENSE.txt",
      "ffmpeg/NOTICE.txt": "ffmpeg/NOTICE.txt",
      "ffmpeg/BUILD-README.txt": "ffmpeg/BUILD-README.txt",
      "ofx/pirosman-ofxhost.exe": "ofx/pirosman-ofxhost.exe",
      "ofx/Plugins/Pirosman Samples.ofx.bundle/Contents/Win64/Pirosman Samples.ofx": "ofx/Plugins/Pirosman Samples.ofx.bundle/Contents/Win64/Pirosman Samples.ofx",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE-MIT": "LICENSE-MIT",
      "../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
